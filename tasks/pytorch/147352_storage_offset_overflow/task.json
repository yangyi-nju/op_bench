  "statement": {
    "title": "as_strided storage-offset bounds check can overflow",
    "body": "The storage bounds check multiplies storage_offset by itemsize and then adds the required storage size with unchecked integer arithmetic. Extreme but valid int64 offsets can wrap, allowing an out-of-bounds view instead of raising a controlled exception. Reuse computeStorageNbytes with the offset so the existing checked arithmetic reports overflow, while preserving the zero-size arbitrary-offset rule.",
    "labels": [
      "module: aten",
      "boundary: integer overflow",
      "operator: as_strided"
    ]
  },
  "operator": {
    "framework": "pytorch",
    "component": "aten.native.checkInBoundsForStorage",
    "operator_name": "torch.as_strided",
    "problem_type": "checked-overflow",
