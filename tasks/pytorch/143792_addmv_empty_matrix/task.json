  "statement": {
    "title": "Inductor addmv decomposition mishandles a zero-sized matrix",
    "body": "The addmv decomposition computes an empty matrix-vector product before applying the broadcast input. For a 0x0 matrix and a broadcastable one-element input, the generic addition path loses native addmv's empty-matrix semantics. Preserve beta=0 behavior, then return beta times the input when the matrix-vector result is empty.",
    "labels": [
      "module: inductor",
      "module: decomposition",
      "boundary: empty"
    ]
  },
