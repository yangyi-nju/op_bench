+import unittest
+
+import torch
+from torch.export import export, unflatten
+from torch.utils._pytree import tree_flatten
+
+
+class _DirectionalDerivativeModel(torch.nn.Module):
+    def forward(self, input, tangent):
+        def function(value):
+            return torch.sin(value) * torch.exp(value)
+
+        return torch.func.jvp(function, (input,), (tangent,))
+
+
+class _NestedDirectionalDerivativeModel(torch.nn.Module):
+    def forward(self, input, tangent):
+        def outer(value):
+            def inner(nested_value):
+                return torch.sin(nested_value)
+
+            primal, derivative = torch.func.jvp(inner, (value,), (value,))
+            return primal + derivative
+
+        return torch.func.jvp(outer, (input,), (tangent,))
+
+
+class _PlainModel(torch.nn.Module):
+    def forward(self, input, other):
+        return torch.tanh(input * other) + input
+
+
+class ProgramTransformScenarioTests(unittest.TestCase):
+    def _inputs(self, seed):
+        torch.manual_seed(seed)
+        return torch.randn(3, 4), torch.randn(3, 4)
+
+    def _assert_tree_close(self, actual, expected):
+        actual_values, actual_spec = tree_flatten(actual)
+        expected_values, expected_spec = tree_flatten(expected)
+        self.assertEqual(actual_spec, expected_spec)
+        self.assertEqual(len(actual_values), len(expected_values))
+        for actual_value, expected_value in zip(actual_values, expected_values):
+            torch.testing.assert_close(actual_value, expected_value)
+
+    def _assert_round_trip(self, model):
+        example = self._inputs(7)
+        rebuilt = unflatten(export(model, example, strict=True))
+        for seed in (17, 41):
+            inputs = self._inputs(seed)
+            self._assert_tree_close(rebuilt(*inputs), model(*inputs))
+
+    def test_directional_derivative_round_trip(self):
+        self._assert_round_trip(_DirectionalDerivativeModel())
+
+    def test_nested_directional_derivative_round_trip(self):
+        self._assert_round_trip(_NestedDirectionalDerivativeModel())
+
+    def test_plain_capture_round_trip(self):
+        self._assert_round_trip(_PlainModel())
+
+
+if __name__ == "__main__":
+    unittest.main()
