  "statement": {
    "title": "CUDA torch.histc accepts an invalid range for int8 input",
    "body": "For a CUDA int8 tensor, torch.histc accepts min=256 and max=1 even though max is not larger than min. It must raise the same clear range error expected for invalid bounds, while valid CUDA histograms and supported integer dtypes continue to work.",
    "labels": [
      "module: cuda",
      "topic: bug fixes",
      "module: histc"
    ]
