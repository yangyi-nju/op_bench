  "statement": {
    "title": "LBFGS line search stops before the expected closure-call count",
    "body": "For the supplied deterministic CPU float32 Conv2d-plus-BatchNorm step, torch.optim.LBFGS uses one outer iteration, a configured evaluation value of five, and the bracketed line search. The step currently stops too early: it must invoke the closure six times and leave ordinary LBFGS state valid. The configured value is not a claim that the total closure-call count is five.",
    "labels": [
      "module: nn",
      "bug"
    ]
