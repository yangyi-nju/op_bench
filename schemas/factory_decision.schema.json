{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpBench Factory DecisionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_type",
    "schema_version",
    "decision_id",
    "candidate_id",
    "candidate_content_hash",
    "rule_set_id",
    "rule_set_hash",
    "target_dimension",
    "target_subclass",
    "findings",
    "disposition",
    "decision_source",
    "prior_decision",
    "created_at",
    "content_hash"
  ],
  "properties": {
    "contract_type": {
      "const": "factory_decision"
    },
    "schema_version": {
      "const": "v1"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^decision:v1:[0-9a-f]{64}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^candidate:v1:[0-9a-f]{64}$"
    },
    "candidate_content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rule_set_id": {
      "type": "string",
      "pattern": "^screening:v1:[0-9a-f]{64}$"
    },
    "rule_set_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target_dimension": {
      "type": "string",
      "enum": [
        "boundary",
        "precision"
      ]
    },
    "target_subclass": {
      "type": "string",
      "enum": [
        "B1",
        "B2",
        "B3",
        "B4",
        "B5",
        "P1",
        "P2",
        "P3",
        "P4",
        "P5"
      ]
    },
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "disposition": {
      "type": "string",
      "enum": [
        "accepted",
        "deferred",
        "rejected"
      ]
    },
    "decision_source": {
      "type": "string",
      "enum": [
        "automation",
        "human_review"
      ]
    },
    "prior_decision": {
      "oneOf": [
        {
          "$ref": "#/$defs/artifact_reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "rule_id",
        "message",
        "observed",
        "expected"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^(metadata|window|change|test|source|runtime|taxonomy|duplicate|review)\\.[a-z0-9][a-z0-9._-]*$"
        },
        "severity": {
          "type": "string",
          "enum": [
            "warning",
            "defer",
            "reject"
          ]
        },
        "rule_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "observed": {},
        "expected": {
          "type": "object"
        }
      }
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_id",
        "content_hash",
        "relative_path"
      ],
      "properties": {
        "artifact_type": {
          "const": "factory_decision"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^decision:v1:[0-9a-f]{64}$"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target_dimension": {
            "const": "boundary"
          }
        }
      },
      "then": {
        "properties": {
          "target_subclass": {
            "enum": [
              "B1",
              "B2",
              "B3",
              "B4",
              "B5"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target_dimension": {
            "const": "precision"
          }
        }
      },
      "then": {
        "properties": {
          "target_subclass": {
            "enum": [
              "P1",
              "P2",
              "P3",
              "P4",
              "P5"
            ]
          }
        }
      }
    }
  ]
}
