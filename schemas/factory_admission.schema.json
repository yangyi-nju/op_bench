{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpBench Factory AdmissionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_type",
    "schema_version",
    "admission_id",
    "candidate",
    "decision",
    "task",
    "state",
    "previous_record_hash",
    "evidence",
    "transition_reason",
    "actor_kind",
    "created_at",
    "content_hash"
  ],
  "properties": {
    "contract_type": {
      "const": "factory_admission"
    },
    "schema_version": {
      "const": "v1"
    },
    "admission_id": {
      "type": "string",
      "pattern": "^admission:v1:[0-9a-f]{64}$"
    },
    "candidate": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact_reference"
        },
        {
          "properties": {
            "artifact_type": {
              "const": "factory_candidate"
            },
            "artifact_id": {
              "pattern": "^candidate:v1:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "decision": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/artifact_reference"
            },
            {
              "properties": {
                "artifact_type": {
                  "const": "factory_decision"
                },
                "artifact_id": {
                  "pattern": "^decision:v1:[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "task": {
      "oneOf": [
        {
          "$ref": "#/$defs/artifact_reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "discovered",
        "deferred",
        "screened",
        "bundled",
        "preflight_passed",
        "baseline_reproduced",
        "gold_resolved",
        "reviewed",
        "verified",
        "rejected",
        "deprecated"
      ]
    },
    "previous_record_hash": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "transition_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "actor_kind": {
      "type": "string",
      "enum": [
        "automation",
        "human"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_id",
        "content_hash",
        "relative_path"
      ],
      "properties": {
        "artifact_type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_type",
        "reference",
        "claims"
      ],
      "properties": {
        "evidence_type": {
          "type": "string",
          "enum": [
            "screening_decision",
            "task_bundle",
            "preflight",
            "baseline",
            "gold",
            "human_review",
            "integrity"
          ]
        },
        "reference": {
          "$ref": "#/$defs/artifact_reference"
        },
        "claims": {
          "type": "object"
        }
      }
    }
  }
}
