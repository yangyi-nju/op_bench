{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpBench environment registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "environments"],
  "properties": {
    "version": {"type": "string", "pattern": "^v[0-9]+$"},
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "framework", "runtime_tier", "docker", "preflight"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "framework": {"type": "string", "minLength": 1},
          "runtime_tier": {
            "type": "string",
            "enum": [
              "cpu_python_overlay",
              "cpu_package_runtime",
              "cpu_source_snapshot_fuller",
              "cuda_declared",
              "cuda_python_overlay",
              "cuda_kernel_build",
              "hardware_specific"
            ]
          },
          "docker": {
            "type": "object",
            "additionalProperties": true,
            "required": ["image"],
            "properties": {
              "image": {"type": "string", "minLength": 1},
              "digest": {"type": ["string", "null"]},
              "digest_kind": {
                "type": "string",
                "enum": ["repo_digest", "local_image_id", "build_hash"]
              },
              "dockerfile": {"type": "string"},
              "build_context": {"type": "string"},
              "platform": {"type": "string"}
            }
          },
          "runtime_artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "strategy",
              "artifact_kind",
              "artifact_id",
              "artifact_digest",
              "artifact_digest_kind",
              "torch_version",
              "python_abi"
            ],
            "properties": {
              "strategy": {
                "type": "string",
                "enum": ["matched_wheel", "source_built_wheel", "full_source_build"]
              },
              "artifact_kind": {"type": "string", "minLength": 1},
              "artifact_id": {"type": "string", "minLength": 1},
              "artifact_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "artifact_digest_kind": {"type": "string", "minLength": 1},
              "torch_version": {"type": "string", "minLength": 1},
              "python_abi": {"type": "string", "minLength": 1},
              "companion_artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "artifact_kind",
                    "artifact_id",
                    "artifact_digest",
                    "artifact_digest_kind"
                  ],
                  "properties": {
                    "artifact_kind": {"type": "string", "minLength": 1},
                    "artifact_id": {"type": "string", "minLength": 1},
                    "artifact_digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "artifact_digest_kind": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          },
          "preflight": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workdir", "commands"],
            "properties": {
              "workdir": {"type": "string", "minLength": 1},
              "commands": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
