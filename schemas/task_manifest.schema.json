{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "op_bench task manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "version",
    "source",
    "statement",
    "operator",
    "environment",
    "agent_visible",
    "evaluation",
    "artifacts",
    "metadata"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "environment_ref": {
      "type": "string",
      "minLength": 1
    },
    "runtime_tier": {
      "type": "string",
      "enum": [
        "cpu-deterministic",
        "single-gpu",
        "kernel-build",
        "cpu_python_overlay",
        "cpu_package_runtime",
        "cpu_source_snapshot_fuller",
        "cuda_declared",
        "cuda_python_overlay",
        "cuda_kernel_build",
        "hardware_specific"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "draft",
            "environment_ready",
            "source_ready",
            "baseline_reproduced",
            "gold_verified",
            "verified",
            "blocked",
            "blocked_environment",
            "blocked_source",
            "blocked_test",
            "not_reproduced",
            "gold_failed",
            "deprecated"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "compatibility_evidence": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.json$"
        },
        "verified_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_module",
        "target_import",
        "selector_module",
        "minimal_operation",
        "evidence"
      ],
      "properties": {
        "target_module": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "target_import": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
        },
        "selector_module": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.py$"
        },
        "minimal_operation": {
          "type": "string",
          "pattern": "^import torch;"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.json$"
        }
      }
    },
    "patch_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths", "mode"],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "mode": {
          "type": "string",
          "enum": ["enforced", "filtered"]
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taxonomy_version",
        "contract_family",
        "execution_context",
        "failure_type"
      ],
      "properties": {
        "taxonomy_version": {
          "const": "v2"
        },
        "contract_family": {
          "type": "string",
          "enum": [
            "result",
            "tensor_metadata",
            "mutation_state",
            "gradient",
            "api_behavior",
            "efficiency_safety"
          ]
        },
        "contract_detail_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "value",
              "numerical",
              "shape",
              "rank",
              "dtype",
              "device",
              "layout",
              "stride",
              "alias",
              "mutation",
              "state",
              "serialization",
              "gradient",
              "schema",
              "exception",
              "compatibility",
              "performance",
              "memory",
              "liveness"
            ]
          }
        },
        "trigger_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "empty_or_zero",
              "scalar_or_low_rank",
              "extreme_value_or_size",
              "invalid_or_endpoint_parameter",
              "noncontiguous_or_special_layout",
              "mixed_dtype_or_precision_mode",
              "dynamic_shape",
              "mutation_or_alias",
              "device_specific"
            ]
          }
        },
        "execution_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["devices", "modes", "phases", "distributed"],
          "properties": {
            "devices": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "enum": ["cpu", "cuda"]}
            },
            "modes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "enum": ["eager", "compile"]}
            },
            "phases": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "enum": ["forward", "backward"]}
            },
            "distributed": {
              "type": "boolean"
            }
          }
        },
        "failure_type": {
          "type": "string",
          "enum": [
            "wrong_result",
            "unexpected_error",
            "missing_error",
            "crash_or_hang",
            "nondeterministic",
            "performance_regression"
          ]
        },
        "root_cause_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "overflow",
              "incorrect_validation",
              "wrong_dispatch",
              "incorrect_cast",
              "bad_gradient_formula",
              "incorrect_lowering"
            ]
          }
        },
        "component_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "aten",
              "autograd",
              "dispatcher",
              "dynamo",
              "inductor",
              "triton",
              "cuda_kernel",
              "distributed"
            ]
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pr_url",
        "issue_url",
        "repo",
        "issue_number",
        "pr_number",
        "base_commit",
        "merge_commit"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "issue_url": {
                "type": "null"
              }
            },
            "required": [
              "issue_url"
            ]
          },
          "then": {
            "properties": {
              "issue_number": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "issue_number": {
                "type": "null"
              }
            },
            "required": [
              "issue_number"
            ]
          },
          "then": {
            "properties": {
              "issue_url": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "pr_url": {
          "type": "string"
        },
        "issue_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "repo_url": {
          "type": "string"
        },
        "issue_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "base_commit": {
          "type": "string",
          "minLength": 7
        },
        "merge_commit": {
          "type": "string",
          "minLength": 7
        },
        "checkout_mode": {
          "type": "string",
          "enum": [
            "git",
            "local-copy"
          ]
        },
        "local_path": {
          "type": "string"
        },
        "snapshot_path": {
          "type": "string"
        },
        "snapshot_hash": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_method": {
          "type": "string",
          "enum": [
            "from_local_repo",
            "github_archive",
            "git_fetch"
          ]
        }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body",
        "labels"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework",
        "component",
        "operator_name",
        "problem_type",
        "tags"
      ],
      "properties": {
        "framework": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "operator_name": {
          "type": "string"
        },
        "problem_type": {
          "type": "string"
        },
        "problem_dimension": {
          "type": "string",
          "enum": [
            "boundary",
            "precision"
          ]
        },
        "problem_subclass": {
          "type": "string",
          "enum": [
            "B1",
            "B2",
            "B3",
            "B4",
            "B5",
            "P1",
            "P2",
            "P3",
            "P4",
            "P5"
          ]
        },
        "failure_contract": {
          "type": "string",
          "enum": [
            "wrong-result",
            "exception",
            "crash-oob",
            "silent-acceptance"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "dependentRequired": {
        "problem_dimension": [
          "problem_subclass"
        ],
        "problem_subclass": [
          "problem_dimension"
        ],
        "failure_contract": [
          "problem_dimension",
          "problem_subclass"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "problem_dimension"
            ],
            "properties": {
              "problem_dimension": {
                "const": "boundary"
              }
            }
          },
          "then": {
            "properties": {
              "problem_subclass": {
                "enum": [
                  "B1",
                  "B2",
                  "B3",
                  "B4",
                  "B5"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "problem_dimension"
            ],
            "properties": {
              "problem_dimension": {
                "const": "precision"
              }
            }
          },
          "then": {
            "properties": {
              "problem_subclass": {
                "enum": [
                  "P1",
                  "P2",
                  "P3",
                  "P4",
                  "P5"
                ]
              }
            }
          }
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "local",
            "docker",
            "remote_docker"
          ]
        },
        "tier": {
          "type": "string",
          "enum": [
            "cpu-deterministic",
            "single-gpu",
            "kernel-build",
            "cpu_python_overlay",
            "cpu_package_runtime",
            "cpu_source_snapshot_fuller",
            "cuda_declared",
            "cuda_python_overlay",
            "cuda_kernel_build",
            "hardware_specific"
          ]
        },
        "image": {
          "type": "string"
        },
        "image_digest": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "remote_execution_config_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "gpus": {
          "type": "string",
          "minLength": 1
        },
        "digest_kind": {
          "type": "string",
          "enum": [
            "repo_digest",
            "local_image_id",
            "build_hash"
          ]
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "dockerfile": {
          "type": "string"
        },
        "build_context": {
          "type": "string"
        },
        "workspace_dir": {
          "type": "string"
        },
        "preflight_workdir": {
          "type": "string"
        },
        "python_executable": {
          "type": "string"
        },
        "preflight_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resource_requirements": {
          "type": "object",
          "additionalProperties": true
        },
        "source_loading": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "python_overlay",
                "prebuilt_source_image",
                "full_source_build",
                "inplace_build"
              ]
            },
            "installed_package": {
              "type": "string",
              "minLength": 1
            },
            "overlay_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "runtime_site_packages": {
              "type": "string",
              "minLength": 1
            },
            "sync_before_tests": {
              "type": "boolean"
            },
            "build_command": {
              "type": "string",
              "minLength": 1
            },
            "build_environment": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "type": ["string", "number", "boolean"]
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "python_overlay"
                  }
                }
              },
              "then": {
                "required": [
                  "installed_package",
                  "overlay_paths",
                  "runtime_site_packages",
                  "sync_before_tests"
                ]
              }
            }
          ]
        },
        "python_version": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "build_mode": {
          "type": "string",
          "enum": [
            "editable-python",
            "source-build",
            "prebuilt-wheel"
          ]
        },
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "device",
            "min_memory_gb"
          ],
          "properties": {
            "device": {
              "type": "string"
            },
            "min_memory_gb": {
              "type": "integer",
              "minimum": 1
            },
            "gpu_model": {
              "type": "string"
            },
            "cuda_version": {
              "type": "string"
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "agent_visible": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_setup_commands",
        "known_constraints",
        "allowed_test_commands"
      ],
      "properties": {
        "public_task_id": {
          "type": "string",
          "pattern": "^opbench-v07-t[0-9]{4}$"
        },
        "repo_setup_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_test_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup_commands",
        "fail_to_pass",
        "pass_to_pass",
        "test_command",
        "timeout_sec"
      ],
      "properties": {
        "setup_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fail_to_pass": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pass_to_pass": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_command": {
          "type": "string"
        },
        "timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "build_timeout_sec": {
          "type": "integer",
          "minimum": 1,
          "description": "Timeout for the source_loading build step (python_overlay sync or inplace_build compile). Defaults to timeout_sec for overlay tiers, 5400s for cuda_kernel_build."
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gold_patch"
      ],
      "properties": {
        "gold_patch": {
          "type": "string"
        },
        "test_patch": {
          "type": "string"
        },
        "hidden_test_patch": {
          "type": "string"
        },
        "public_test_patch": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "difficulty",
        "curation_status",
        "deterministic",
        "estimated_runtime_min"
      ],
      "properties": {
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "curation_status": {
          "type": "string",
          "enum": [
            "draft",
            "verified"
          ]
        },
        "deterministic": {
          "type": "boolean"
        },
        "estimated_runtime_min": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        },
        "layer": {
          "type": "string",
          "enum": [
            "A",
            "B"
          ]
        },
        "admission_status": {
          "type": "string",
          "enum": [
            "candidate",
            "environment_ready",
            "source_ready",
            "baseline_reproduced",
            "gold_verified",
            "verified",
            "blocked",
            "blocked_environment",
            "blocked_source",
            "blocked_test",
            "not_reproduced",
            "gold_failed",
            "deprecated"
          ]
        },
        "source_loading_verified": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "required": ["environment_ref"]
        }
      },
      "then": {
        "properties": {
          "environment": {
            "required": [
              "tier",
              "image",
              "python_version",
              "os",
              "build_mode",
              "hardware",
              "dependencies"
            ]
          }
        }
      }
    }
  ]
}
